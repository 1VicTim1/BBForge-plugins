{
  "id": "xenforo",
  "name": "XenForo 2",
  "description": "Стандартные BBCode движка XenForo 2",
  "detect": {
    "tags": [
      "ispoiler",
      "icode",
      "attach",
      "media",
      "heading",
      "user",
      "plain",
      "indent"
    ]
  },
  "tags": [
    {
      "name": "b",
      "label": "Жирный",
      "blankCheck": true
    },
    {
      "name": "i",
      "label": "Курсив",
      "blankCheck": true
    },
    {
      "name": "u",
      "label": "Подчёркнутый",
      "blankCheck": true
    },
    {
      "name": "s",
      "label": "Зачёркнутый",
      "blankCheck": true
    },
    {
      "name": "color",
      "label": "Цвет",
      "value": "required",
      "blankCheck": true
    },
    {
      "name": "font",
      "label": "Шрифт",
      "value": "required",
      "valueFormat": "font",
      "blankCheck": true
    },
    {
      "name": "size",
      "label": "Размер (1–7)",
      "value": "required",
      "valueFormat": "size",
      "blankCheck": true
    },
    {
      "name": "url",
      "label": "Ссылка",
      "value": "optional",
      "valueFormat": "url"
    },
    {
      "name": "email",
      "role": "inline",
      "label": "Почта",
      "value": "optional",
      "render": {
        "element": "u"
      }
    },
    {
      "name": "img",
      "label": "Изображение"
    },
    {
      "name": "media",
      "role": "media",
      "label": "Видео",
      "value": "required",
      "render": {
        "element": "span",
        "className": "media-placeholder",
        "caption": "▶ {value}:"
      }
    },
    {
      "name": "attach",
      "role": "media",
      "label": "Вложение",
      "value": "optional",
      "render": {
        "element": "span",
        "className": "media-placeholder",
        "caption": "Вложение"
      }
    },
    {
      "name": "quote",
      "label": "Цитата",
      "value": "optional"
    },
    {
      "name": "code",
      "label": "Код",
      "value": "optional"
    },
    {
      "name": "icode",
      "role": "inline",
      "label": "Код в строке",
      "raw": true,
      "render": {
        "element": "code"
      }
    },
    {
      "name": "plain",
      "role": "inline",
      "label": "Без разметки",
      "raw": true,
      "render": {
        "element": "span"
      }
    },
    {
      "name": "list",
      "label": "Список",
      "value": "optional"
    },
    {
      "name": "*",
      "label": "Пункт"
    },
    {
      "name": "left",
      "label": "Влево",
      "blankCheck": true
    },
    {
      "name": "center",
      "label": "По центру",
      "blankCheck": true
    },
    {
      "name": "right",
      "label": "Вправо",
      "blankCheck": true
    },
    {
      "name": "indent",
      "role": "block",
      "label": "Отступ",
      "value": "optional",
      "render": {
        "element": "div",
        "style": {
          "padding": "0 0 0 24px"
        }
      }
    },
    {
      "name": "spoiler",
      "label": "Спойлер",
      "value": "optional"
    },
    {
      "name": "ispoiler",
      "role": "inline",
      "label": "Скрытый текст",
      "render": {
        "element": "mark"
      }
    },
    {
      "name": "heading",
      "role": "block",
      "label": "Заголовок",
      "value": "required",
      "valueFormat": "size",
      "render": {
        "element": "strong",
        "style": {
          "display": "block",
          "fontSize": "1.3em",
          "margin": "8px 0 4px"
        }
      }
    },
    {
      "name": "user",
      "role": "inline",
      "label": "Упоминание",
      "value": "required",
      "valueFormat": "text",
      "render": {
        "element": "strong",
        "caption": "@"
      }
    },
    {
      "name": "table",
      "role": "block",
      "label": "Таблица",
      "render": {
        "element": "div",
        "style": {
          "display": "table",
          "border": "1px solid #8888"
        }
      }
    },
    {
      "name": "tr",
      "role": "block",
      "label": "Строка таблицы",
      "render": {
        "element": "div",
        "style": {
          "display": "table-row"
        }
      }
    },
    {
      "name": "th",
      "role": "block",
      "label": "Заголовок столбца",
      "render": {
        "element": "strong",
        "style": {
          "display": "table-cell",
          "padding": "2px 6px"
        }
      }
    },
    {
      "name": "td",
      "role": "block",
      "label": "Ячейка",
      "render": {
        "element": "div",
        "style": {
          "display": "table-cell",
          "padding": "2px 6px"
        }
      }
    }
  ]
}
