{
  "manifestVersion": 1,
  "type": "plugin",
  "id": "bbforge.profile-selector",
  "name": "Выбор профиля форума",
  "version": "2.0.0",
  "description": "Список профилей форумов в строке состояния, оформленный как акцентная метка: «Автоматически» (профиль определяется по тегам и ссылкам документа) или конкретный форум. Заменяет обычную надпись профиля. Другие плагины добавляют пункты через точку расширения bbforge.profile-selector.options.",
  "author": "1VicTim1",
  "homepage": "https://github.com/1VicTim1/BBForge-plugins",
  "engine": ">=0.3.0",
  "permissions": [
    "ui.add",
    "ui.modify",
    "ui.slots",
    "profiles.select",
    "commands",
    "styles"
  ],
  "contributes": {
    "slots": [
      {
        "id": "bbforge.profile-selector.options",
        "title": "Дополнительные пункты списка профилей"
      }
    ],
    "ui": [
      {
        "op": "add",
        "slot": "statusbar.right",
        "before": "status.profile",
        "item": {
          "id": "bbforge.profile-selector.select",
          "kind": "select",
          "title": "Профиль форума",
          "tooltip": "Набор тегов, по которому проверяется документ",
          "bind": "profile",
          "source": "profiles",
          "itemsSlot": "bbforge.profile-selector.options",
          "className": "profile-pill"
        }
      },
      {
        "op": "add",
        "slot": "menu.tools",
        "after": "app.plugins",
        "item": {
          "id": "bbforge.profile-selector.default-entry",
          "kind": "command",
          "command": "bbforge.profile-selector.default"
        }
      },
      {
        "op": "update",
        "target": "status.profile",
        "set": {
          "hidden": true
        }
      }
    ],
    "commands": [
      {
        "id": "bbforge.profile-selector.default",
        "title": "Профиль форума: 4PDA",
        "category": "Профиль",
        "icon": "globe",
        "run": {
          "setProfile": "4pda"
        }
      }
    ],
    "styles": [
      "selector.css"
    ]
  }
}
