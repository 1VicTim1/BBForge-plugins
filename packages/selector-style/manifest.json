{
  "manifestVersion": 1,
  "type": "plugin",
  "id": "bbforge.selector-style",
  "name": "Оформление выбора профиля",
  "version": "1.0.0",
  "description": "Показывает список профилей форума как акцентную метку со значком и убирает дублирующую надпись профиля из строки состояния.",
  "author": "1VicTim1",
  "homepage": "https://github.com/1VicTim1/BBForge-plugins",
  "engine": ">=0.3.0",
  "dependencies": { "bbforge.profile-selector": "^1.0.0" },
  "permissions": ["styles", "ui.modify"],
  "contributes": {
    "styles": ["selector.css"],
    "ui": [
      { "op": "update", "target": "bbforge.profile-selector.select", "set": { "className": "profile-pill" } },
      { "op": "update", "target": "status.profile", "set": { "hidden": true } }
    ]
  }
}
